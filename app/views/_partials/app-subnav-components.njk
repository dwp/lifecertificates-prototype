{% set navTitle = "Custom components and patterns" %}
{% set navItems = appComponents %}

<nav class="app-subnav" aria-label="{{ navTitle }}">
  <h2 class="govuk-heading-s">{{ navTitle }}</h2>
  <ul class="app-subnav__section">

    {% for item in navItems %}

      <li class="app-subnav__section-item
        {% if pageName == item.text %}app-subnav__section-item--current{% endif %}
        ">
        <a class="app-subnav__link govuk-link govuk-link--no-visited-state govuk-link--no-underline"
           href="{{ item.href }}">{{ item.text }}</a>
      </li>

    {% endfor %}

  </ul>
</nav>
